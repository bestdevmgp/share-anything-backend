# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
BASE_URL=http://localhost:8080

# Database Configuration
DATABASE_URL=mysql://user:password@localhost:3306/share_anything

# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_EXPIRATION_HOURS=24

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# Naver OAuth
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
NAVER_REDIRECT_URI=http://localhost:8080/auth/naver/callback

# S3 Configuration (Cloudflare R2 or AWS S3)
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET_NAME=your-bucket-name
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_PREFIX=

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Cloudflare Turnstile Configuration
# Get your secret key from: https://dash.cloudflare.com/
# 1. Go to Turnstile menu
# 2. Add site with "Managed" widget mode
# 3. Add your domain and localhost for development
# 4. Copy the Secret Key (not the Site Key - Site Key is for frontend)
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
